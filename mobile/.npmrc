# EAS cloud builds run plain `npm ci`, which hard-fails on the react-dom@19.3.1
# peer-vs-react@19.3.0 conflict in the lockfile (npm install here has always
# needed --legacy-peer-deps — see HANDOVER). This makes local `npm ci` and the
# EAS "Install dependencies" phase behave the same way.
legacy-peer-deps=true
