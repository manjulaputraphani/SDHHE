# FCM web push — Firebase console → Project settings → Your apps → Web app
# (copy the SDK snippet values here). Until ALL FOUR are set, the web keeps
# using the VAPID Web Push path (still working) and FCM stays off.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_PROJECT_ID=sdhhe-88e59
VITE_FIREBASE_MESSAGING_SENDER_ID=987189733393
# Web Push certificate (Cloud Messaging → Web configuration) — only needed
# if Firebase's getToken() asks for a vapidKey.
VITE_FIREBASE_VAPID_KEY=
